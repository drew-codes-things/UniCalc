(define (fail msg)
  (display msg)
  (newline)
  (exit 1))

(define (format-result r)
  (if (= r (truncate r))
      (begin (display (inexact->exact (truncate r))) (newline))
      (begin (display r) (newline))))

(define args (cdr (command-line)))

(if (not (= (length args) 3))
    (fail "Error: expected 3 arguments <a> <op> <b>")
    (let* ((a-str (car args))
           (op (cadr args))
           (b-str (caddr args))
           (a-parsed (string->number a-str))
           (b-parsed (string->number b-str)))
      (if (or (not a-parsed) (not b-parsed))
          (fail "Error: invalid number")
          (let ((a (exact->inexact a-parsed))
                (b (exact->inexact b-parsed)))
            (cond
              ((string=? op "+") (format-result (+ a b)))
              ((string=? op "-") (format-result (- a b)))
              ((string=? op "*") (format-result (* a b)))
              ((string=? op "/")
               (if (= b 0)
                   (fail "Error: division by zero")
                   (format-result (/ a b))))
              (else (fail "Error: unknown operator")))))))
