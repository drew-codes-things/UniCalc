(defun fail (msg)
  (format t "~A~%" msg)
  (sb-ext:exit :code 1))

(defun format-result (r)
  (if (= r (truncate r))
      (format t "~D~%" (truncate r))
      (format t "~F~%" r)))

(let ((args (rest sb-ext:*posix-argv*)))
  (if (/= (length args) 3)
      (fail "Error: expected 3 arguments <a> <op> <b>")
      (let* ((a-str (first args))
             (op (second args))
             (b-str (third args))
             (a (ignore-errors (read-from-string a-str)))
             (b (ignore-errors (read-from-string b-str))))
        (if (or (not (numberp a)) (not (numberp b)))
            (fail "Error: invalid number")
            (let ((a (coerce a 'double-float))
                  (b (coerce b 'double-float)))
              (cond
                ((string= op "+") (format-result (+ a b)))
                ((string= op "-") (format-result (- a b)))
                ((string= op "*") (format-result (* a b)))
                ((string= op "/")
                 (if (= b 0)
                     (fail "Error: division by zero")
                     (format-result (/ a b))))
                (t (fail "Error: unknown operator"))))))))
